{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ashu AI Companion",
  "version": "0.9.1",
  "identifier": "com.ashu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src-tauri/web-dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: https:; connect-src 'self' http://localhost:8765 http://127.0.0.1:8765 ws://localhost:8765 ws://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "enabled": true,
      "endpoints": ["https://api.github.com/repos/<your-username>/ashu-ai-companion/releases/latest"],
      "dialog": true,
      "pubkey": ""
    },
    "singleInstance": true
  }
}