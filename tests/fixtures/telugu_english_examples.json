      "forbidden_terms": []
    },
    {
      "id": "reminder_request",
      "stage": "best_friend",
      "user": "Remind me 10 minutes lo call cheyyali ani",
      "expected_language": "mixed",
      "expect_any_terms": ["remind", "10", "call", "chestha", "sare"],
      "forbidden_terms": ["i love you"]
    },
    {
      "id": "hindi_scaffold",
      "stage": "acquaintance",
      "user": "Kal milte hain",
