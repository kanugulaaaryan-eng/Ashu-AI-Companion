      "forbidden_terms": ["sweetheart", "baby", "kiss me"]
    },
    {
      "id": "bored_tease",
      "stage": "comfortable_friend",
      "user": "Chala bore kodtundi ra",
      "expected_language": "te",
      "expect_any_terms": ["bore", "cheyyi", "chestha", "time", "pani"],
      "forbidden_terms": ["i love you", "flirt"]
    },
    {
      "id": "care_message",
      "stage": "best_friend",
      "user": "Naku chala tension ga undi, exam undi",
      "expected_language": "te",
      "expect_any_terms": ["tension", "exam", "kudirithe", "chestha", "nenu", "relax"],
      "forbidden_terms": ["i love you", "baby"]
    },
    {
      "id": "mixed_reply",
      "stage": "acquaintance",
      "user": "Em chestunav? Project deadline undi",
      "expected_language": "mixed",
      "expect_any_terms": ["project", "deadline", "chestha", "chestunna", "em"],
      "forbidden_terms": ["honey", "sweetie"]
    },
    {
      "id": "memory_command_recall",
      "stage": "comfortable_friend",
